{
  "title": "Stdlib: CHECKPOINT, ASSERT, EXPLAIN",
  "id": "stdlib-debug-explain",
  "category": "debugging",
  "tags": ["checkpoint", "assert", "explain", "trace", "ai-canonical"],
  "aiSubset": "compatible",
  "description": "Guard a calculation, mark checkpoints, and view provenance via EXPLAIN. Enable tracing to see EXPLAIN output.",
  "program": [
    "CHECKPOINT(\"start\")",
    "LET subtotal = SUM(input.items)",
    "LET discount = input.discount ?? 0",
    "LET total = subtotal - discount",
    "ASSERT(total >= 0, \"total cannot be negative\")",
    "CHECKPOINT(\"ready\")",
    "",
    "OUTPUT {",
    "    subtotal: subtotal,",
    "    discount: discount,",
    "    total: total,",
    "    explain_total: EXPLAIN(\"total\")",
    "}"
  ],
  "input": {
    "items": [
      15.0,
      20.0,
      12.5
    ],
    "discount": 5.0
  },
  "diagnosticExpectation": {
    "success": true,
    "subsetCompatibility": "COMPATIBLE"
  },
  "trace": true
}
