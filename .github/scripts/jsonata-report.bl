SHARED jmh MANY;
SHARED state MANY;

FUNC engineRank(engine) = CASE {
    WHEN engine == "kotlin" THEN 0
    WHEN engine == "branchline-interpreter" THEN 1
    WHEN engine == "branchline-vm" THEN 2
    WHEN engine == "dashjoin" THEN 3
    WHEN engine == "ibm" THEN 4
    ELSE 99
};

FUNC formatNumber(value) {
    IF value == NULL THEN {
        RETURN "n/a";
    }
    LET text = TRIM(STRING(value));
    IF text == "" THEN {
        RETURN "n/a";
    }
    LET lower = LOWER(text);
    IF lower == "nan" || lower == "inf" || lower == "+inf" || lower == "-inf"
        || lower == "infinity" || lower == "+infinity" || lower == "-infinity" THEN {
        RETURN "n/a";
    }
    LET numeric = MATCH(text, "^[+-]?([0-9]+\\.[0-9]+|[0-9]+\\.?|\\.[0-9]+)([eE][+-]?[0-9]+)?$");
    IF numeric == NULL THEN {
        RETURN "n/a";
    }
    RETURN STRING(ROUND(NUMBER(text), 3));
}

FUNC decimalOrNull(value) {
    IF value == NULL THEN {
        RETURN NULL;
    }
    LET text = TRIM(STRING(value));
    IF text == "" THEN {
        RETURN NULL;
    }
    LET lower = LOWER(text);
    IF lower == "nan" || lower == "inf" || lower == "+inf" || lower == "-inf"
        || lower == "infinity" || lower == "+infinity" || lower == "-infinity" THEN {
        RETURN NULL;
    }
    RETURN DEC(text);
}

FUNC formatRatio(value) {
    IF value == NULL THEN {
        RETURN "n/a";
    }
    RETURN formatNumber(value) + "x";
}

FUNC formatSpeedup(value) {
    IF value == NULL THEN {
        RETURN "n/a";
    }
    RETURN formatNumber(value) + "x";
}

FUNC csvCell(value) {
    IF value == NULL THEN {
        RETURN "";
    }
    LET text = STRING(value);
    LET flat = REPLACE(text, "[\\r\\n]+", " ");
    RETURN REPLACE(flat, ",", ";");
}

FUNC markdownCell(value) {
    IF value == NULL THEN {
        RETURN "";
    }
    LET text = STRING(value);
    LET flat = REPLACE(text, "[\\r\\n]+", " ");
    RETURN REPLACE(flat, "\\|", "\\\\|");
}

FUNC isDisplayEngine(engine) {
    RETURN engine == "branchline-interpreter"
        || engine == "branchline-vm"
        || engine == "dashjoin"
        || engine == "ibm";
}

FUNC boolText(value) {
    IF value == TRUE THEN {
        RETURN "true";
    }
    RETURN "false";
}

FUNC isComparableValue(value) {
    IF value == TRUE THEN {
        RETURN TRUE;
    }
    LET text = LOWER(TRIM(STRING(value)));
    RETURN text == "true";
}

FUNC stateCaseId(row) {
    RETURN GET(row, "case", row.caseId ?? "");
}

FUNC findState(stateRows, engine, caseId) {
    FOR row IN stateRows {
        IF row.engine == engine && stateCaseId(row) == caseId THEN {
            RETURN row;
        }
    }
    RETURN NULL;
}

FUNC normalizeState(stateRow) {
    IF stateRow == NULL THEN {
        RETURN {
            validationState: "missing_state",
            comparable: FALSE,
            phase: "report",
            reason: "No state-report.json row for engine/case",
            notes: ""
        };
    }
    RETURN {
        validationState: stateRow.validation_state ?? "unknown",
        comparable: isComparableValue(stateRow.comparable ?? FALSE),
        phase: stateRow.phase ?? "",
        reason: stateRow.reason ?? "",
        notes: stateRow.notes ?? ""
    };
}

FUNC resolveAllocBytes(entry) {
    LET secondary = entry.secondaryMetrics ?? {};
    LET allocKey = NULL;
    FOR key IN KEYS(secondary) {
        IF CONTAINS(STRING(key), "gc.alloc.rate.norm") THEN {
            SET allocKey = key;
        }
    }
    IF allocKey == NULL THEN {
        RETURN NULL;
    }
    LET metric = GET(secondary, allocKey, NULL);
    IF metric == NULL THEN {
        RETURN NULL;
    }
    LET raw = NUMBER(metric.score);
    IF raw == NULL THEN {
        RETURN NULL;
    }
    IF raw < 0 THEN {
        RETURN DEC(0);
    }
    RETURN DEC(raw);
}

FUNC credibilityFlag(row) {
    LET rawScore = NUMBER(row.score);
    IF rawScore == NULL THEN {
        RETURN "";
    }
    LET score = DEC(rawScore);
    IF row.allocBytes != NULL && row.allocBytes <= DEC(16) && score >= DEC(10000000) THEN {
        RETURN "implausible_high_score_near_zero_alloc";
    }
    IF row.allocBytes == NULL && score >= DEC(100000000) THEN {
        RETURN "implausible_high_score_no_alloc_metric";
    }
    RETURN "";
}

FUNC isEligibleSpeedupRow(row) {
    RETURN row.comparable == TRUE && row.credibilityFlag == "";
}

FUNC buildSortKey(row, idx) {
    LET engineKey = PAD(STRING(INT(engineRank(row.engine))), -2, "0");
    LET caseKey = STRING(row.caseId);
    LET indexKey = PAD(STRING(INT(idx)), -4, "0");
    RETURN engineKey + "::" + caseKey + "::" + indexKey;
}

FUNC sortRows(rows) {
    LET keys = [];
    LET idx = 0;
    FOR row IN rows {
        SET keys = APPEND(keys, buildSortKey(row, idx));
        SET idx = idx + 1;
    }
    LET sortedKeys = SORT(keys);
    LET out = [];
    FOR key IN sortedKeys {
        LET parts = SPLIT(key, "::");
        LET pos = INT(parts[2]);
        SET out = APPEND(out, rows[pos]);
    }
    RETURN out;
}

FUNC findScore(rows, caseId, engineId) {
    FOR row IN rows {
        IF row.caseId == caseId && row.engine == engineId THEN {
            RETURN row.score;
        }
    }
    RETURN NULL;
}

FUNC findEligibleScore(rows, caseId, engineId) {
    FOR row IN rows {
        IF row.caseId == caseId && row.engine == engineId && isEligibleSpeedupRow(row) THEN {
            RETURN row.score;
        }
    }
    RETURN NULL;
}

FUNC resolveFastestJsonata(ibmScore, dashjoinScore) {
    IF ibmScore == NULL && dashjoinScore == NULL THEN {
        RETURN { engine: NULL, score: NULL };
    }
    IF dashjoinScore == NULL THEN {
        RETURN { engine: "ibm", score: ibmScore };
    }
    IF ibmScore == NULL THEN {
        RETURN { engine: "dashjoin", score: dashjoinScore };
    }
    IF dashjoinScore >= ibmScore THEN {
        RETURN { engine: "dashjoin", score: dashjoinScore };
    }
    RETURN { engine: "ibm", score: ibmScore };
}

FUNC sumValues(values) {
    LET total = 0;
    FOR value IN values {
        SET total = total + value;
    }
    RETURN total;
}

FUNC maxValue(values) {
    LET max = NULL;
    FOR value IN values {
        IF max == NULL || value > max THEN {
            SET max = value;
        }
    }
    RETURN max;
}

FUNC medianValue(values) {
    LET count = LENGTH(values);
    IF count == 0 THEN {
        RETURN NULL;
    }
    LET sorted = SORT(values);
    LET half = INT(FLOOR(count / 2));
    LET isEven = count == half * 2;
    IF isEven THEN {
        LET left = sorted[half - 1];
        LET right = sorted[half];
        RETURN (left + right) / 2;
    }
    RETURN sorted[half];
}

FUNC collectScores(rows, caseIds, engineId) {
    LET scores = [];
    FOR caseId IN caseIds {
        LET score = findEligibleScore(rows, caseId, engineId);
        IF score != NULL THEN {
            SET scores = APPEND(scores, score);
        }
    }
    RETURN scores;
}

FUNC filterDashjoinAnomalies(rows, caseIds) {
    LET scores = collectScores(rows, caseIds, "dashjoin");
    LET median = medianValue(scores);
    IF median == NULL THEN {
        RETURN { included: caseIds, excluded: [], median: NULL, upper: NULL };
    }
    LET upper = median * 100;
    LET included = [];
    LET excluded = [];
    FOR caseId IN caseIds {
        LET score = findEligibleScore(rows, caseId, "dashjoin");
        IF score == NULL THEN {
            SET excluded = APPEND(excluded, caseId);
        } ELSE {
            IF score > upper THEN {
                SET excluded = APPEND(excluded, caseId);
            } ELSE {
                SET included = APPEND(included, caseId);
            }
        }
    }
    RETURN { included: included, excluded: excluded, median: median, upper: upper };
}

FUNC collectSpeedups(rows, caseIds, branchEngine, jsonataEngine) {
    LET fasterRatios = [];
    LET total = 0;
    FOR caseId IN caseIds {
        LET branchScore = findEligibleScore(rows, caseId, branchEngine);
        LET jsonataScore = findEligibleScore(rows, caseId, jsonataEngine);
        IF branchScore != NULL && jsonataScore != NULL THEN {
            SET total = total + 1;
            LET ratio = branchScore / jsonataScore;
            IF ratio > 1 THEN {
                SET fasterRatios = APPEND(fasterRatios, ratio);
            }
        }
    }
    LET fasterCount = LENGTH(fasterRatios);
    LET avgSpeedup = CASE {
        WHEN fasterCount == 0 THEN NULL
        ELSE sumValues(fasterRatios) / fasterCount
    };
    LET maxSpeedup = CASE {
        WHEN fasterCount == 0 THEN NULL
        ELSE maxValue(fasterRatios)
    };
    RETURN {
        fasterCount: fasterCount,
        total: total,
        avgSpeedup: avgSpeedup,
        maxSpeedup: maxSpeedup
    };
}

FUNC buildSpeedupSummary(rows, caseIds) {
    LET lines = [];
    SET lines = APPEND(lines, "### Branchline speedup summary");
    SET lines = APPEND(lines, "");
    SET lines = APPEND(lines, "Counts include cases where both engines have scores, comparable state, and no credibility flag. Speedup is Branchline ops/s divided by Dashjoin ops/s.");
    SET lines = APPEND(lines, "");
    SET lines = APPEND(lines, "| Comparison | Faster cases | Total cases | Avg speedup (faster cases) | Max speedup |");
    SET lines = APPEND(lines, "| --- | ---: | ---: | ---: | ---: |");

    LET comparisons = [
        { label: "Interpreter vs Dashjoin", branch: "branchline-interpreter", jsonata: "dashjoin" },
        { label: "VM vs Dashjoin", branch: "branchline-vm", jsonata: "dashjoin" }
    ];
    FOR comp IN comparisons {
        LET summary = collectSpeedups(rows, caseIds, comp.branch, comp.jsonata);
        LET line = "| " + comp.label
            + " | " + STRING(summary.fasterCount)
            + " | " + STRING(summary.total)
            + " | " + formatSpeedup(summary.avgSpeedup)
            + " | " + formatSpeedup(summary.maxSpeedup)
            + " |";
        SET lines = APPEND(lines, line);
    }
    SET lines = APPEND(lines, "");
    RETURN JOIN(lines, "\n");
}

FUNC buildMarkdown(rows, stateRowCount) {
    LET display = [];
    FOR row IN rows {
        IF isDisplayEngine(row.engine) THEN {
            SET display = APPEND(display, row);
        }
    }
    LET cases = [];
    FOR row IN display {
        SET cases = APPEND(cases, row.caseId);
    }
    LET caseIds = SORT(DISTINCT(cases));

    LET lines = [];
    SET lines = APPEND(lines, "## JSONata cross-engine results");
    SET lines = APPEND(lines, "");
    SET lines = APPEND(lines, "Source data: [CSV](jsonata-summary.csv).");
    SET lines = APPEND(lines, "");
    SET lines = APPEND(lines, "Scores are throughput in ops/s (higher is faster). Ratios compare Branchline throughput to the fastest JSONata engine.");
    SET lines = APPEND(lines, "Rows require comparable state and no credibility flag before they count toward speedup summaries.");
    IF stateRowCount == 0 THEN {
        SET lines = APPEND(lines, "");
        SET lines = APPEND(lines, "State report warning: no state rows were provided, so no rows are treated as comparable.");
    }
    SET lines = APPEND(lines, "");
    LET dashjoinFilter = filterDashjoinAnomalies(display, caseIds);
    LET filteredCaseIds = dashjoinFilter.included;
    LET excludedCaseIds = dashjoinFilter.excluded;
    SET lines = APPEND(lines, "Dashjoin outliers are excluded from the summary and breakdown (outside 0.01x–100x Dashjoin median).");
    IF LENGTH(excludedCaseIds) > 0 THEN {
        SET lines = APPEND(lines, "");
        SET lines = APPEND(lines, "Excluded cases: " + JOIN(excludedCaseIds, ", ") + ".");
    }
    SET lines = APPEND(lines, "");
    SET lines = APPEND(lines, buildSpeedupSummary(display, filteredCaseIds));
    SET lines = APPEND(lines, "### Case breakdown");
    SET lines = APPEND(lines, "| Case | Branchline Interpreter (ops/s) | Branchline VM (ops/s) | Fastest JSONata (ops/s) | Fastest JSONata engine | Interpreter vs JSONata | VM vs JSONata |");
    SET lines = APPEND(lines, "| --- | ---: | ---: | ---: | --- | ---: | ---: |");
    FOR caseId IN filteredCaseIds {
        LET interp = findEligibleScore(display, caseId, "branchline-interpreter");
        LET vm = findEligibleScore(display, caseId, "branchline-vm");
        LET dashjoin = findEligibleScore(display, caseId, "dashjoin");
        LET ibm = findEligibleScore(display, caseId, "ibm");
        LET fastest = resolveFastestJsonata(ibm, dashjoin);
        LET fastestEngine = CASE {
            WHEN fastest.engine == NULL THEN "n/a"
            ELSE fastest.engine
        };
        LET interpRatio = CASE {
            WHEN interp == NULL || fastest.score == NULL THEN NULL
            ELSE interp / fastest.score
        };
        LET vmRatio = CASE {
            WHEN vm == NULL || fastest.score == NULL THEN NULL
            ELSE vm / fastest.score
        };
        LET line = "| " + caseId
            + " | " + formatNumber(interp)
            + " | " + formatNumber(vm)
            + " | " + formatNumber(fastest.score)
            + " | " + fastestEngine
            + " | " + formatRatio(interpRatio)
            + " | " + formatRatio(vmRatio)
            + " |";
        SET lines = APPEND(lines, line);
    }
    SET lines = APPEND(lines, "");
    SET lines = APPEND(lines, "### Row state");
    SET lines = APPEND(lines, "| Engine | Case | Score (ops/s) | Allocation (B/op) | Validation state | Comparable | Credibility flag | Reason |");
    SET lines = APPEND(lines, "| --- | --- | ---: | ---: | --- | --- | --- | --- |");
    FOR row IN display {
        LET flag = CASE {
            WHEN row.credibilityFlag == "" THEN "ok"
            ELSE row.credibilityFlag
        };
        LET reason = CASE {
            WHEN row.reason == "" THEN "n/a"
            ELSE row.reason
        };
        LET line = "| " + markdownCell(row.engine)
            + " | " + markdownCell(row.caseId)
            + " | " + formatNumber(row.score)
            + " | " + formatNumber(row.allocBytes)
            + " | " + markdownCell(row.validationState)
            + " | " + boolText(row.comparable)
            + " | " + markdownCell(flag)
            + " | " + markdownCell(reason)
            + " |";
        SET lines = APPEND(lines, line);
    }
    RETURN JOIN(lines, "\n");
}

FUNC buildCsv(rows) {
    LET lines = ["engine,case,score,score_error,unit,alloc_b_op,validation_state,comparable,phase,reason,notes,credibility_flag"];
    FOR row IN rows {
        LET line = csvCell(row.engine)
            + "," + csvCell(row.caseId)
            + "," + formatNumber(row.score)
            + "," + formatNumber(row.scoreError)
            + "," + csvCell(row.unit)
            + "," + formatNumber(row.allocBytes)
            + "," + csvCell(row.validationState)
            + "," + boolText(row.comparable)
            + "," + csvCell(row.phase)
            + "," + csvCell(row.reason)
            + "," + csvCell(row.notes)
            + "," + csvCell(row.credibilityFlag);
        SET lines = APPEND(lines, line);
    }
    RETURN JOIN(lines, "\n");
}

TRANSFORM JsonataReport {
    LET raw = [];
    FOR key IN KEYS(jmh) {
        SET raw = APPEND(raw, LISTIFY(AWAIT_SHARED("jmh", key)));
    }
    LET entries = FLATTEN(raw);
    LET stateRaw = [];
    FOR key IN KEYS(state) {
        SET stateRaw = APPEND(stateRaw, LISTIFY(AWAIT_SHARED("state", key)));
    }
    LET stateRows = FLATTEN(stateRaw);
    LET rows = [];
    FOR entry IN entries {
        LET params = entry.params ?? {};
        LET engine = params.engineId ?? NULL;
        IF engine != NULL THEN {
            LET caseId = params.caseId ?? "";
            LET primary = entry.primaryMetric ?? {};
            LET stateInfo = normalizeState(findState(stateRows, engine, caseId));
            LET row = {
                engine: engine,
                caseId: caseId,
                score: decimalOrNull(primary.score),
                scoreError: decimalOrNull(primary.scoreError),
                unit: primary.scoreUnit ?? "",
                allocBytes: resolveAllocBytes(entry),
                validationState: stateInfo.validationState,
                comparable: stateInfo.comparable,
                phase: stateInfo.phase,
                reason: stateInfo.reason,
                notes: stateInfo.notes
            };
            SET rows = APPEND(rows, {
                engine: row.engine,
                caseId: row.caseId,
                score: row.score,
                scoreError: row.scoreError,
                unit: row.unit,
                allocBytes: row.allocBytes,
                validationState: row.validationState,
                comparable: row.comparable,
                phase: row.phase,
                reason: row.reason,
                notes: row.notes,
                credibilityFlag: credibilityFlag(row)
            });
        }
    }
    LET sorted = sortRows(rows);
    LET markdown = buildMarkdown(sorted, LENGTH(stateRows));
    LET csv = buildCsv(sorted);

    OUTPUT {
        rows: LENGTH(sorted),
        files: {
            "jsonata-summary.md": markdown,
            "jsonata-summary.csv": csv
        }
    };
}
